{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": { "includes": ["**", "!**/dist", "!**/node_modules", "!loadtests/results", "!scratch", "!deploy/grafana/dashboards"] },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 160 },
  "linter": {
    "rules": {
      "recommended": true,
      "style": { "noNonNullAssertion": "error", "useTemplate": "off" },
      "a11y": { "noLabelWithoutControl": "off" },
      "suspicious": { "noArrayIndexKey": "off" },
      "complexity": { "noImportantStyles": "off" }
    }
  },
  "overrides": [{ "includes": ["**/*.css"], "linter": { "rules": { "style": { "noDescendingSpecificity": "off" } } } }],
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
